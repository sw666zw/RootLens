local.file_match "inventory_logs" {
  path_targets = [{
    "__address__" = "localhost",
    "__path__"    = "/var/log/rootlens/inventory.jsonl",
    "environment" = "local",
    "job"         = "inventory-service",
    "service"     = "inventory",
  }]
  sync_period = "5s"
}

loki.source.file "inventory_logs" {
  targets    = local.file_match.inventory_logs.targets
  forward_to = [loki.process.inventory_logs.receiver]
}

loki.process "inventory_logs" {
  stage.json {
    expressions = {
      level     = "level",
      timestamp = "timestamp",
    }
  }

  stage.timestamp {
    source            = "timestamp"
    format            = "RFC3339Nano"
    action_on_failure = "fudge"
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
