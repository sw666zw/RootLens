# Local-development defaults only. Replace these values outside local development.
POSTGRES_DB=rootlens_inventory
POSTGRES_USER=rootlens
POSTGRES_PASSWORD=rootlens_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rootlens:rootlens_dev_password@localhost:5432/rootlens_inventory

ORDER_POSTGRES_DB=rootlens_orders
ORDER_POSTGRES_USER=rootlens_order
ORDER_POSTGRES_PASSWORD=rootlens_order_dev_password
ORDER_POSTGRES_PORT=5433
ORDER_DATABASE_URL=postgresql+asyncpg://rootlens_order:rootlens_order_dev_password@localhost:5433/rootlens_orders

# Business services run directly on the host.
ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=8001
DIAGNOSIS_SERVICE_HOST=0.0.0.0
DIAGNOSIS_SERVICE_PORT=8002
INVENTORY_SERVICE_URL=http://localhost:8000
ORDER_SERVICE_URL=http://localhost:8001

# Development-only controlled incident setup. Never enable in production.
ROOTLENS_FAULT_INJECTION_ENABLED=false
ROOTLENS_INCIDENT_OUTPUT_DIR=runtime/incidents

# Business-service traces exported to the local OpenTelemetry Collector.
OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAME=rootlens-inventory
ORDER_OTEL_SERVICE_NAME=rootlens-order
DIAGNOSIS_OTEL_SERVICE_NAME=rootlens-diagnosis
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=always_on

# Business-service JSON-lines output tailed by the local Alloy container.
ROOTLENS_FILE_LOGGING_ENABLED=true
ROOTLENS_LOG_FILE_PATH=runtime/logs/inventory.jsonl
ROOTLENS_ORDER_LOG_FILE_PATH=runtime/logs/order.jsonl
ROOTLENS_DIAGNOSIS_LOG_FILE_PATH=runtime/logs/diagnosis.jsonl

# Local Grafana login only. Replace both values outside local development.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rootlens_local_only

# Deterministic diagnosis-engine telemetry sources and output.
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_QUERY_URL=http://localhost:16686
ROOTLENS_DIAGNOSIS_OUTPUT_DIR=runtime/diagnoses
ROOTLENS_DIAGNOSIS_WINDOW_PADDING_SECONDS=15
ROOTLENS_TELEMETRY_TIMEOUT_SECONDS=10

# Optional explanation layer. Template mode is offline and deterministic.
ROOTLENS_EXPLANATION_PROVIDER=template
ROOTLENS_LLM_ENABLED=false
ROOTLENS_EXPLANATION_OUTPUT_DIR=runtime/explanations
ROOTLENS_LLM_TIMEOUT_SECONDS=30
ROOTLENS_LLM_MAX_OUTPUT_TOKENS=1200

# OpenAI API access is separate from a ChatGPT subscription. Keep this private.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
