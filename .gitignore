# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variable files
.env
.env.*
*.env
!.env.example

# Generated logs
*.log
logs/
!runtime/logs/
runtime/logs/*
!runtime/logs/.gitkeep
# Explicit documentation of the two local service log targets.
runtime/logs/inventory.jsonl
runtime/logs/order.jsonl

# Generated incident ground truth (kept outside the Loki-mounted log directory)
!runtime/incidents/
runtime/incidents/*
!runtime/incidents/.gitkeep

# Generated diagnosis and evaluation reports
!runtime/diagnoses/
runtime/diagnoses/*
!runtime/diagnoses/.gitkeep

# Generated explanation and offline validation reports
!runtime/explanations/
runtime/explanations/*
!runtime/explanations/.gitkeep

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Visual Studio Code
.vscode/

# PyCharm and IntelliJ-based IDEs
.idea/
*.iml
